# Secrets — copy to .env, then: chmod 600 .env
# Generate with: openssl rand -hex 32

# Bearer token agents must present to the gateway API
JOBSEARCH_API_TOKEN=change-me-openssl-rand-hex-32

# SearXNG instance secret (required, SearXNG refuses to start without it)
SEARXNG_SECRET=change-me-openssl-rand-hex-32

# Comma-separated enabled sources: bundesagentur, searxng (eures optional, see gateway/jobsearch_gateway/sources/eures.py)
JOBSEARCH_SOURCES=bundesagentur,searxng

# Optional: restrict SearXNG queries to these job boards (site: OR-groups)
# SEARXNG_SITE_FILTERS=stepstone.de,monster.de,indeed.com,karriere.de

# Optional: EURES requires a (free) API key from the EU developer portal.
# Unset = connector stays disabled.
# JOBSEARCH_EURES_API_KEY=

# Optional
TZ=Europe/Berlin